{
  "name": "projetocasernadeadulao",
  "version": "1.0.0",
  "private": true,
  "description": "Prospecto pastoral Discipulando a Caserna — Projeto Caserna de Adulão",
  "scripts": {
    "generate": "node ferramentas/gerar-dados.js",
    "generate:apresentacao": "node ferramentas/gerar-apresentacao-homologacao.js",
    "check:encoding": "node ferramentas/check-encoding.js",
    "check:guia-mestre": "node ferramentas/verificar-guia-mestre.js",
    "lint:html": "node ferramentas/lint-html.js",
    "lint:css": "stylelint css/**/*.css",
    "lint:js": "eslint js/**/*.js ferramentas/**/*.js testes/**/*.js",
    "format:check": "prettier --check css/**/*.css js/**/*.js ferramentas/**/*.js testes/**/*.js *.md conteudo/**/*.md docs/**/*.md",
    "test": "node --test testes/unitarios/*.test.js",
    "test:a11y": "playwright test testes/e2e/site.spec.js -g \"a11y\"",
    "test:e2e": "playwright test testes/e2e",
    "validate": "npm run generate && npm run check:encoding && npm run check:guia-mestre && npm run lint:html && npm run lint:css && npm run lint:js && npm run test && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@higgsfield/cli": "^1.1.20",
    "@playwright/test": "^1.54.1",
    "axe-core": "^4.10.3",
    "eslint": "^9.31.0",
    "html-validate": "^9.7.1",
    "prettier": "^3.6.2",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0"
  },
  "allowScripts": {
    "@higgsfield/cli@1.1.20": true
  }
}
