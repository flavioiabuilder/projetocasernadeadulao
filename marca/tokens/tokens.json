{
  "meta": {
    "marca": "Projeto Caserna de Adulão",
    "sigla": "PCA",
    "versao": "0.1.0-candidate",
    "status": "HOMOLOGADO",
    "data": "2026-08-05",
    "fonte": "index.html (:root) + assets/img/logo-pca/LEIA-ME.md",
    "fonteVerdade": "marca/tokens/tokens.json",
    "arquivosGerados": ["tokens.css"],
    "nota": "Não unificar com Discipulando a Caserna (navy/Montserrat)."
  },
  "primitive": {
    "color": {
      "carvao": {
        "$value": "#0e1216",
        "$css": "--color-carvao",
        "$description": "Campo escuro / traços da marca"
      },
      "azul-pedra": {
        "$value": "#151c24",
        "$css": "--color-azul-pedra",
        "$description": "Profundidade secundária"
      },
      "pedra": {
        "$value": "#5c6570",
        "$css": "--color-pedra",
        "$description": "Neutro médio"
      },
      "areia": {
        "$value": "#c4b8a5",
        "$css": "--color-areia",
        "$description": "Neutro quente claro"
      },
      "papel": {
        "$value": "#f3eee6",
        "$css": "--color-papel",
        "$description": "Superfície clara institucional"
      },
      "papel-quente": {
        "$value": "#ebe4d8",
        "$css": "--color-papel-quente",
        "$description": "Alternativa de papel"
      },
      "bronze": {
        "$value": "#8b6f47",
        "$css": "--color-bronze",
        "$description": "Acento / filete da marca"
      },
      "bronze-deep": {
        "$value": "#6e5634",
        "$css": "--color-bronze-deep",
        "$description": "Bronze escuro"
      },
      "bronze-claro": {
        "$value": "#a8875a",
        "$css": "--color-bronze-claro",
        "$description": "Bronze hover / claro"
      },
      "ambar": {
        "$value": "#e8c98a",
        "$css": "--color-ambar",
        "$description": "Acento suave / foco"
      },
      "branco-suave": {
        "$value": "#f7f3ec",
        "$css": "--color-branco-suave",
        "$description": "Texto sobre ink"
      },
      "texto-escuro": {
        "$value": "#1a1f24",
        "$css": "--color-texto-escuro",
        "$description": "Texto sobre papel"
      },
      "texto-medio": {
        "$value": "#3d4650",
        "$css": "--color-texto-medio",
        "$description": "Texto secundário sobre papel"
      },
      "button-primary-fg": {
        "$value": "#fffdf8",
        "$css": "--color-button-primary-fg",
        "$description": "Texto em botão primário"
      }
    },
    "font": {
      "display": {
        "$value": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif",
        "$css": "--font-display",
        "$description": "Display / títulos (H3 — stacks atuais)"
      },
      "sans": {
        "$value": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "$css": "--font-sans",
        "$description": "UI / corpo (H3 — stacks atuais)"
      }
    },
    "text": {
      "xs": {
        "$value": "clamp(0.75rem, 0.72rem + 0.15vw, 0.8125rem)",
        "$css": "--text-xs"
      },
      "sm": {
        "$value": "clamp(0.875rem, 0.84rem + 0.2vw, 0.9375rem)",
        "$css": "--text-sm"
      },
      "base": {
        "$value": "clamp(1rem, 0.96rem + 0.25vw, 1.125rem)",
        "$css": "--text-base"
      },
      "md": {
        "$value": "clamp(1.125rem, 1.05rem + 0.4vw, 1.35rem)",
        "$css": "--text-md"
      },
      "lg": {
        "$value": "clamp(1.35rem, 1.15rem + 0.9vw, 1.85rem)",
        "$css": "--text-lg"
      },
      "xl": {
        "$value": "clamp(1.75rem, 1.35rem + 1.6vw, 2.75rem)",
        "$css": "--text-xl"
      },
      "2xl": {
        "$value": "clamp(2.25rem, 1.6rem + 2.8vw, 4rem)",
        "$css": "--text-2xl"
      },
      "3xl": {
        "$value": "clamp(2.6rem, 1.85rem + 3.4vw, 4.75rem)",
        "$css": "--text-3xl"
      }
    },
    "space": {
      "2xs": { "$value": "0.25rem", "$css": "--space-2xs" },
      "xs": { "$value": "0.5rem", "$css": "--space-xs" },
      "sm": { "$value": "0.75rem", "$css": "--space-sm" },
      "md": { "$value": "1rem", "$css": "--space-md" },
      "lg": { "$value": "1.5rem", "$css": "--space-lg" },
      "xl": { "$value": "2rem", "$css": "--space-xl" },
      "2xl": { "$value": "3rem", "$css": "--space-2xl" },
      "3xl": { "$value": "4.5rem", "$css": "--space-3xl" },
      "4xl": { "$value": "7rem", "$css": "--space-4xl" },
      "5xl": { "$value": "10rem", "$css": "--space-5xl" }
    },
    "layout": {
      "measure": { "$value": "38rem", "$css": "--measure" },
      "measure-wide": { "$value": "48rem", "$css": "--measure-wide" },
      "measure-narrow": { "$value": "28rem", "$css": "--measure-narrow" },
      "shell": {
        "$value": "min(72rem, calc(100% - 2 * var(--gutter)))",
        "$css": "--shell"
      },
      "gutter": {
        "$value": "max(1.25rem, env(safe-area-inset-left, 0px), 4vw)",
        "$css": "--gutter"
      },
      "gutter-end": {
        "$value": "max(1.25rem, env(safe-area-inset-right, 0px), 4vw)",
        "$css": "--gutter-end"
      }
    },
    "radius": {
      "sm": { "$value": "0.25rem", "$css": "--radius-sm" },
      "md": { "$value": "0.5rem", "$css": "--radius-md" }
    },
    "line": {
      "hair": { "$value": "1px", "$css": "--line-hair" }
    },
    "shadow": {
      "soft": {
        "$value": "0 1.25rem 3rem rgba(14, 18, 22, 0.18)",
        "$css": "--shadow-soft"
      }
    },
    "motion": {
      "dur-fast": { "$value": "180ms", "$css": "--dur-fast" },
      "dur-base": { "$value": "420ms", "$css": "--dur-base" },
      "dur-slow": { "$value": "780ms", "$css": "--dur-slow" },
      "ease-out": {
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
        "$css": "--ease-out"
      },
      "ease-soft": {
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "$css": "--ease-soft"
      },
      "reveal-distance": {
        "$value": "1.25rem",
        "$css": "--reveal-distance"
      }
    },
    "z": {
      "progress": { "$value": "40", "$css": "--z-progress" },
      "header": { "$value": "50", "$css": "--z-header" },
      "skip": { "$value": "60", "$css": "--z-skip" }
    },
    "nav": {
      "height": { "$value": "4.25rem", "$css": "--nav-height" }
    }
  },
  "semantic": {
    "surface": {
      "ink": {
        "$value": "{primitive.color.carvao}",
        "$css": "--surface-ink"
      },
      "deep": {
        "$value": "{primitive.color.azul-pedra}",
        "$css": "--surface-deep"
      },
      "paper": {
        "$value": "{primitive.color.papel}",
        "$css": "--surface-paper"
      },
      "paper-alt": {
        "$value": "{primitive.color.papel-quente}",
        "$css": "--surface-paper-alt"
      },
      "elevated": {
        "$value": "rgba(243, 238, 230, 0.06)",
        "$css": "--surface-elevated"
      }
    },
    "text": {
      "on-ink": {
        "$value": "{primitive.color.branco-suave}",
        "$css": "--text-on-ink"
      },
      "on-ink-muted": {
        "$value": "rgba(247, 243, 236, 0.84)",
        "$css": "--text-on-ink-muted"
      },
      "on-paper": {
        "$value": "{primitive.color.texto-escuro}",
        "$css": "--text-on-paper"
      },
      "on-paper-muted": {
        "$value": "{primitive.color.texto-medio}",
        "$css": "--text-on-paper-muted"
      }
    },
    "accent": {
      "default": {
        "$value": "{primitive.color.bronze}",
        "$css": "--accent"
      },
      "soft": {
        "$value": "{primitive.color.ambar}",
        "$css": "--accent-soft"
      }
    },
    "border": {
      "ink": {
        "$value": "rgba(196, 184, 165, 0.28)",
        "$css": "--border-ink"
      },
      "paper": {
        "$value": "rgba(26, 31, 36, 0.14)",
        "$css": "--border-paper"
      }
    },
    "focus": {
      "ring": {
        "$value": "{primitive.color.ambar}",
        "$css": "--focus-ring"
      },
      "ring-ink": {
        "$value": "{primitive.color.carvao}",
        "$css": "--focus-ring-ink"
      }
    }
  },
  "component": {
    "button": {
      "min-height": {
        "$value": "2.75rem",
        "$css": "--button-min-height",
        "$description": "Alvo mínimo ~44px"
      },
      "padding-block": {
        "$value": "0.75rem",
        "$css": "--button-padding-block"
      },
      "padding-inline": {
        "$value": "1.25rem",
        "$css": "--button-padding-inline"
      },
      "radius": {
        "$value": "{primitive.radius.sm}",
        "$css": "--button-radius"
      },
      "primary-bg": {
        "$value": "{semantic.accent.default}",
        "$css": "--button-primary-bg"
      },
      "primary-fg": {
        "$value": "{primitive.color.button-primary-fg}",
        "$css": "--button-primary-fg"
      },
      "primary-hover-bg": {
        "$value": "{primitive.color.bronze-claro}",
        "$css": "--button-primary-hover-bg"
      },
      "ghost-border": {
        "$value": "{semantic.border.ink}",
        "$css": "--button-ghost-border"
      },
      "ink-bg": {
        "$value": "{semantic.surface.ink}",
        "$css": "--button-ink-bg"
      },
      "ink-hover-bg": {
        "$value": "{semantic.surface.deep}",
        "$css": "--button-ink-hover-bg"
      }
    },
    "header": {
      "height": {
        "$value": "{primitive.nav.height}",
        "$css": "--header-height"
      }
    },
    "hero": {
      "mark-size": {
        "$value": "5rem",
        "$css": "--hero-mark-size",
        "$description": "Tamanho do escudo no hero institucional"
      }
    },
    "link": {
      "underline-offset": {
        "$value": "0.18em",
        "$css": "--link-underline-offset"
      }
    }
  }
}
