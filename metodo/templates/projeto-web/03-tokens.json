{
  "$comentario": "Template GLOBAL ME-T — placeholders apenas. Não embutir paleta de um piloto. Folhas tipadas usam $value/$type/$description; aliases: {primitivos.caminho.do.token}.",
  "meta": {
    "projeto": "{{NOME_DO_PROJETO}}",
    "programa": "{{NOME_DO_PROGRAMA}}",
    "versao": "0.0.0",
    "status": "TEMPLATE",
    "formato": "ME-T",
    "contratoVersao": "1.0",
    "unidadeEspacamentoBase": "{{4px|outro}}",
    "notacaoCor": "{{hex|oklch|mista}}",
    "fonteVerdadeRuntime": "json",
    "arquivosGerados": ["tokens.css"]
  },
  "primitivos": {
    "cor": {
      "neutro": {
        "0": {
          "$value": "{{PLACEHOLDER}}",
          "$type": "color",
          "$description": "Superfície mais clara"
        },
        "50": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
        "100": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
        "500": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
        "900": { "$value": "{{PLACEHOLDER}}", "$type": "color" }
      },
      "marca": {
        "primaria": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
        "secundaria": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
        "destaque": { "$value": "{{PLACEHOLDER}}", "$type": "color" }
      }
    },
    "tipografia": {
      "familiaDisplay": {
        "$value": "{{PLACEHOLDER}}",
        "$type": "fontFamily"
      },
      "familiaCorpo": {
        "$value": "{{PLACEHOLDER}}",
        "$type": "fontFamily"
      },
      "tamanhoBase": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "escala": {
        "xs": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
        "sm": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
        "md": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
        "lg": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
        "xl": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
      },
      "alturaLinha": {
        "aperto": { "$value": "{{PLACEHOLDER}}", "$type": "number" },
        "corpo": { "$value": "{{PLACEHOLDER}}", "$type": "number" }
      }
    },
    "espacamento": {
      "1": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "2": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "3": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "4": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "6": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "8": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "12": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "16": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
    },
    "layout": {
      "container": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "gutter": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
    },
    "raio": {
      "nenhum": { "$value": "0", "$type": "dimension" },
      "sutil": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "controle": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "circular": { "$value": "9999px", "$type": "dimension" }
    },
    "borda": {
      "fina": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "media": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
    },
    "elevacao": {
      "nenhuma": { "$value": "none", "$type": "shadow" },
      "discreta": { "$value": "{{PLACEHOLDER}}", "$type": "shadow" }
    },
    "motion": {
      "duracaoRapida": { "$value": "{{PLACEHOLDER}}", "$type": "duration" },
      "duracaoPadrao": { "$value": "{{PLACEHOLDER}}", "$type": "duration" },
      "duracaoLenta": { "$value": "{{PLACEHOLDER}}", "$type": "duration" },
      "easingPadrao": { "$value": "{{PLACEHOLDER}}", "$type": "cubicBezier" }
    },
    "foco": {
      "largura": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "cor": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
      "offset": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
    },
    "breakpoints": {
      "navCompacta": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "leituraAmpla": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" },
      "layoutAmplo": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
    }
  },
  "semanticos": {
    "cor": {
      "superficie": {
        "$value": "{primitivos.cor.neutro.0}",
        "$type": "color"
      },
      "texto": {
        "$value": "{primitivos.cor.neutro.900}",
        "$type": "color"
      },
      "textoSuave": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
      "borda": { "$value": "{{PLACEHOLDER}}", "$type": "color" },
      "acentoEditorial": {
        "$value": "{primitivos.cor.marca.destaque}",
        "$type": "color"
      },
      "foco": {
        "$value": "{primitivos.foco.cor}",
        "$type": "color"
      }
    },
    "tipografia": {
      "tituloPagina": { "$value": "{{PLACEHOLDER}}", "$type": "typography" },
      "tituloSecao": { "$value": "{{PLACEHOLDER}}", "$type": "typography" },
      "corpo": { "$value": "{{PLACEHOLDER}}", "$type": "typography" },
      "rotulo": { "$value": "{{PLACEHOLDER}}", "$type": "typography" }
    },
    "espacamento": {
      "secao": {
        "$value": "{primitivos.espacamento.16}",
        "$type": "dimension"
      },
      "bloco": {
        "$value": "{primitivos.espacamento.8}",
        "$type": "dimension"
      },
      "inline": {
        "$value": "{primitivos.espacamento.2}",
        "$type": "dimension"
      }
    },
    "layout": {
      "larguraConteudo": {
        "$value": "{primitivos.layout.container}",
        "$type": "dimension"
      },
      "gutterPagina": {
        "$value": "{primitivos.layout.gutter}",
        "$type": "dimension"
      },
      "medidaProsa": { "$value": "{{PLACEHOLDER}}", "$type": "dimension" }
    },
    "raio": {
      "controle": {
        "$value": "{primitivos.raio.controle}",
        "$type": "dimension"
      },
      "midia": {
        "$value": "{primitivos.raio.nenhum}",
        "$type": "dimension"
      }
    },
    "borda": {
      "separador": {
        "$value": "{primitivos.borda.fina}",
        "$type": "dimension"
      }
    },
    "elevacao": {
      "painel": {
        "$value": "{primitivos.elevacao.discreta}",
        "$type": "shadow"
      }
    },
    "motion": {
      "transicaoUi": {
        "$value": "{primitivos.motion.duracaoPadrao}",
        "$type": "duration"
      },
      "respeitarReducedMotion": {
        "$value": true,
        "$type": "boolean"
      }
    },
    "foco": {
      "anel": {
        "$value": "{primitivos.foco.largura}",
        "$type": "dimension"
      }
    },
    "breakpoints": {
      "navCompacta": {
        "$value": "{primitivos.breakpoints.navCompacta}",
        "$type": "dimension"
      },
      "layoutAmplo": {
        "$value": "{primitivos.breakpoints.layoutAmplo}",
        "$type": "dimension"
      }
    }
  }
}
